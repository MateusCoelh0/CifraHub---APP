{
  "name": "cifrahub-live",
  "version": "1.0.0",
  "description": "App de cifras musicais para shows ao vivo com sincronização WebSocket em tempo real",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "start:legacy": "node server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:set-owner-password": "tsx scripts/seed-owner.ts",
    "test:api": "node scripts/test-api.js",
    "db:check": "node scripts/check-db.js",
    "db:import-legacy": "node scripts/import-legacy-data.js"
  },
  "keywords": [
    "cifras",
    "musica",
    "websocket",
    "palco",
    "show"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
